  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "\r",
          "const apiName = pm.info.requestName;\r",
          "const httpMethod = pm.request.method;\r",
          "const statusCode = pm.response.code;\r",
          "\r",
          "\r",
          "// ⏱️ Response Time Assertion (Threshold: 2000ms = 2 seconds)\r",
          "pm.test(\"Response time is acceptable (under 2000ms)\", function () {\r",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
          "});\r",
          "\r",
          "// 🛡️️ 2. Server Error Safety Check (Ensures NO 5xx Server Errors)\r",
          "pm.test(\"Server is healthy (No 5xx Server Errors)\", function () {\r",
          "    pm.response.to.not.have.status(500);\r",
          "    pm.response.to.not.have.status(502);\r",
          "    pm.response.to.not.have.status(503);\r",
          "});\r",
          "\r",
          "// 2. تحديد الـ Status Code المتوقع تلقائياً بناءً على نوع الـ Request\r",
          "let expectedStatuses = [200]; // Default for GET, PUT, PATCH\r",
          "\r",
          "if (httpMethod === 'POST') {\r",
          "    expectedStatuses = [200, 201];\r",
          "} else if (httpMethod === 'DELETE') {\r",
          "    expectedStatuses = [200, 201, 204];\r",
          "}\r",
          "\r",
          "// 3. طباعة اسم الـ API والـ Method والـ Code في نتيجة الفحص تلقائياً\r",
          "pm.test(`[${httpMethod}] ${apiName} -> Returned Status: ${statusCode}`, function () {\r",
          "    pm.expect(expectedStatuses).to.include(statusCode);\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
